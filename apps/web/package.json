{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "bun run routes:generate && bun check",
    "routes:generate": "bun scripts/generate-route-tree.ts",
    "build": "vp build",
    "serve": "vp preview",
    "preview": "vp preview",
    "dev": "vp dev",
    "dev:bare": "vp dev",
    "dev:portless": "portless",
    "test": "node ../../node_modules/vitest/dist/cli.js run --config vitest.config.ts",
    "test:coverage": "node ../../node_modules/vitest/dist/cli.js run --config vitest.config.ts --coverage",
    "test:e2e": "NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1 playwright test --config playwright.config.ts",
    "test:prototypes": "NO_PROXY=localhost,127.0.0.1,::1,.localhost no_proxy=localhost,127.0.0.1,::1,.localhost playwright test --config playwright.prototypes.config.ts --project desktop --project mobile",
    "test:hydration": "NO_PROXY=localhost,127.0.0.1,::1,.localhost no_proxy=localhost,127.0.0.1,::1,.localhost playwright test --config playwright.prototypes.config.ts --project hydration --workers 4",
    "vite": "vp"
  },
  "dependencies": {
    "@fenchem-lp/ui": "workspace:*",
    "@solidjs/web": "2.0.0-rc.15",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/solid-router": "2.0.0-rc.8",
    "@tanstack/solid-start": "2.0.0-rc.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide": "1.59.0",
    "motion": "^14.0.0",
    "solid-js": "2.0.0-rc.15",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@fenchem-lp/config": "workspace:*",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/router-generator": "1.167.28",
    "@testing-library/dom": "^10.4.2",
    "@types/three": "^0.186.0",
    "jsdom": "^30.1.2",
    "portless": "^0.15.7",
    "typescript": "next",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "portless": "fenchem"
}
