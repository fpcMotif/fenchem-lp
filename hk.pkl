amends "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Config.pkl"

steps {
  ["lint"] {
    glob = "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}"
    check = "bun lint {{files}}"
    fix = "bun lint --fix {{files}}"
  }
  ["delayed-dom-lookup"] {
    glob = List("apps/web/src/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}")
    check = "bun scripts/check-delayed-dom-lookup.ts {{files}}"
  }
  ["typecheck"] {
    glob = "*.{ts,tsx,mts,cts}"
    check = "bun apps/web/scripts/generate-route-tree.ts && bun check --no-script -b"
  }
  ["test-ui"] {
    glob = "scripts/ui/**/*.ts"
    check = "bun run test:ui"
  }
  ["fmt"] {
    glob = "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,yaml,yml,md}"
    check = "bun fmt --check {{files}}"
    fix = "bun fmt {{files}}"
  }
}
