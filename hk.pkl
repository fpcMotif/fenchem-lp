amends "package://github.com/jdx/hk/releases/download/v2.3.1/hk@2.3.1#/Config.pkl"

steps {
  ["lint"] {
    glob = "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}"
    check = "bun lint {{files}}"
    fix = "bun lint --fix {{files}}"
  }
  ["fmt"] {
    glob = "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,yaml,yml,md}"
    check = "bun fmt --check {{files}}"
    fix = "bun fmt {{files}}"
  }
}
