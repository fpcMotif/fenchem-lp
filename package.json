{
  "name": "fenchem-lp",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "latest",
      "typescript": "next",
      "next-themes": "latest",
      "react": "latest",
      "react-dom": "latest",
      "@types/react": "latest",
      "@types/react-dom": "latest",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
      "vitest": "5.0.4",
      "vite-plus": "1.2.0",
      "@vitest/coverage-v8": "5.0.4"
    }
  },
  "type": "module",
  "scripts": {
    "qa": "bun --no-env-file tools/qa/run.mjs",
    "qa:check": "bun --no-env-file tools/qa/self-check.mjs",
    "qa:browser": "bun --no-env-file tools/qa/run.mjs browser",
    "qa:smoke": "bun --no-env-file tools/qa/run.mjs smoke",
    "qa:setup": "bun --no-env-file tools/qa/run.mjs setup",
    "qa:doctor": "bun --no-env-file tools/qa/run.mjs doctor",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "tsc -p packages/ui --noEmit && tsc -p apps/web",
    "typecheck": "tsc -p packages/ui --noEmit && tsc -p apps/web",
    "check:lint": "oxlint && oxfmt --check && bun scripts/check-stylex-types.ts",
    "check:stylex": "bun scripts/check-stylex-types.ts",
    "lint": "vp lint",
    "format": "oxfmt",
    "test": "vp run --filter web test",
    "test:coverage": "vp run --filter web test:coverage",
    "test:e2e": "vp run --filter web test:e2e",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:web:portless": "vp run --filter web dev:portless",
    "deploy": "vp run --filter @fenchem-lp/infra deploy",
    "destroy": "vp run --filter @fenchem-lp/infra destroy",
    "doctor": "react-doctor",
    "perf": "node perf/run.mjs",
    "perf:build": "node perf/measure-build.mjs",
    "perf:assets": "node perf/measure-assets.mjs",
    "perf:coldstart": "node perf/measure-coldstart.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@fenchem-lp/config": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react-doctor": "^0.9.18",
    "rolldown": "1.2.13",
    "typescript": "next",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@stylexswc/unplugin@0.19.1": "patches/@stylexswc%2Funplugin@0.19.1.patch"
  }
}
