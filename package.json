{
  "name": "fenchem-lp",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "latest",
      "typescript": "next"
    }
  },
  "type": "module",
  "scripts": {
    "qa": "bun --no-env-file tools/qa/run.mjs",
    "qa:check": "bun --no-env-file tools/qa/self-check.mjs",
    "qa:browser": "bun --no-env-file tools/qa/run.mjs browser",
    "qa:smoke": "bun --no-env-file tools/qa/run.mjs smoke",
    "qa:setup": "bun --no-env-file tools/qa/run.mjs setup",
    "qa:doctor": "bun --no-env-file tools/qa/run.mjs doctor",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check": "bun run typecheck && bun lint && bun run check:jsx-reads && bun fmt --check",
    "check:jsx-reads": "bun scripts/check-jsx-double-read.ts",
    "check-types": "bun run typecheck",
    "typecheck": "bun apps/web/scripts/generate-route-tree.ts && cd packages/config && bun check -b -p ../..",
    "check:lint": "bun lint && bun fmt && bun scripts/check-stylex-types.ts",
    "check:stylex": "bun scripts/check-stylex-types.ts",
    "lint": "bun lint",
    "format": "bun fmt",
    "test": "vp run --filter web test",
    "test:coverage": "vp run --filter web test:coverage",
    "test:e2e": "vp run --filter web test:e2e",
    "test:prototypes": "vp run --filter web test:prototypes",
    "ui": "bun scripts/ui/cli.ts",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:web:portless": "vp run --filter web dev:portless",
    "deploy": "vp run --filter @fenchem-lp/infra deploy",
    "destroy": "vp run --filter @fenchem-lp/infra destroy",
    "perf": "node perf/run.mjs",
    "perf:build": "node perf/measure-build.mjs",
    "perf:assets": "node perf/measure-assets.mjs",
    "perf:coldstart": "node perf/measure-coldstart.mjs"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.1",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@fenchem-lp/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.3",
    "lightningcss": "^1.33.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "rolldown": "1.2.13",
    "typescript": "next",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "overrides": {
    "@solidjs/babel-plugin": "2.0.0-rc.15",
    "@solidjs/compiler": "2.0.0-rc.15",
    "@solidjs/signals": "2.0.0-rc.15",
    "@solidjs/web": "2.0.0-rc.15",
    "solid-js": "2.0.0-rc.15",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@tanstack/solid-start@2.0.0-rc.8": "patches/@tanstack%2Fsolid-start@2.0.0-rc.8.patch"
  }
}
