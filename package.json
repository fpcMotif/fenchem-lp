{
  "name": "fenchem-lp",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "latest",
      "typescript": "next",
      "next-themes": "latest",
      "react": "latest",
      "react-dom": "latest",
      "convex": "latest",
      "@types/react": "latest",
      "@types/react-dom": "latest"
    }
  },
  "type": "module",
  "scripts": {
    "qa": "bun --no-env-file tools/qa/run.mjs",
    "qa:check": "bun --no-env-file tools/qa/self-check.mjs",
    "qa:browser": "bun --no-env-file tools/qa/run.mjs browser",
    "qa:smoke": "bun --no-env-file tools/qa/run.mjs smoke",
    "qa:setup": "bun --no-env-file tools/qa/run.mjs setup",
    "qa:doctor": "bun --no-env-file tools/qa/run.mjs doctor",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "bun check -p packages/ui && bun check -p apps/web",
    "typecheck": "bun check -p packages/ui && bun check -p apps/web",
    "check:lint": "oxlint && oxfmt --write && bun scripts/check-stylex-types.ts",
    "check:stylex": "bun scripts/check-stylex-types.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp run --filter web test",
    "test:coverage": "vp run --filter web test:coverage",
    "test:e2e": "vp run --filter web test:e2e",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:web:portless": "vp run --filter web dev:portless",
    "dev:server": "vp run --filter @fenchem-lp/backend dev",
    "dev:setup": "vp run --filter @fenchem-lp/backend dev:setup",
    "deploy": "vp run --filter @fenchem-lp/infra deploy",
    "destroy": "vp run --filter @fenchem-lp/infra destroy",
    "doctor": "react-doctor",
    "perf": "node perf/run.mjs",
    "perf:build": "node perf/measure-build.mjs",
    "perf:assets": "node perf/measure-assets.mjs",
    "perf:coldstart": "node perf/measure-coldstart.mjs"
  },
  "dependencies": {
    "@fenchem-lp/env": "workspace:*",
    "@stylexjs/stylex": "^0.19.1",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@fenchem-lp/config": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react-doctor": "^0.9.17",
    "rolldown": "1.2.13",
    "typescript": "next",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@stylexswc/unplugin@0.18.5": "patches/@stylexswc%2Funplugin@0.18.5.patch"
  }
}
