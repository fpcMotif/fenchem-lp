{
  "name": "fenchem-lp",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "next-themes": "^0.4.6",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "convex": "^1.33.1",
      "better-auth": "~1.6.9",
      "@convex-dev/better-auth": "^0.12.2",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "alchemy": "^0.91.2"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "oxlint && oxfmt --write && bun scripts/check-stylex-types.ts",
    "check:stylex": "bun scripts/check-stylex-types.ts",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp run --filter web test",
    "test:coverage": "vp run --filter web test:coverage",
    "test:e2e": "vp run --filter web test:e2e",
    "staged": "vp staged",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter @fenchem-lp/backend dev",
    "dev:setup": "vp run --filter @fenchem-lp/backend dev:setup",
    "deploy": "vp run --filter @fenchem-lp/infra deploy",
    "destroy": "vp run --filter @fenchem-lp/infra destroy",
    "doctor": "react-doctor",
    "perf": "node perf/run.mjs",
    "perf:build": "node perf/measure-build.mjs",
    "perf:assets": "node perf/measure-assets.mjs",
    "perf:coldstart": "node perf/measure-coldstart.mjs"
  },
  "dependencies": {
    "@fenchem-lp/env": "workspace:*",
    "@stylexjs/stylex": "^0.19.0",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@cloudflare/workers-types": "^4.20251213.0",
    "@fenchem-lp/config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.8",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react-doctor": "^0.5.1",
    "rolldown": "1.1.0",
    "typescript": "catalog:",
    "vite-plus": "0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "bun@1.3.11",
  "patchedDependencies": {
    "@stylexswc/unplugin@0.18.5": "patches/@stylexswc%2Funplugin@0.18.5.patch"
  }
}
