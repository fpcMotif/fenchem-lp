hite-space:pre-line}\",\r\n      \".oa-snapshot-confirm{margin-top:4px;width:100%;display:inline-flex;align-items:center;justify-content:center;border:none;border-radius:12px;padding:11px 20px;background:linear-gradient(135deg,rgba(37,99,235,.96),rgba(79,70,229,.94));color:#fff;font:inherit;font-weight:700;cursor:pointer;box-shadow:0 10px 22px rgba(37,99,235,.28),0 1px 0 rgba(255,255,255,.24) inset}\",\r\n      \".oa-snapshot-confirm:not(:disabled):hover{filter:brightness(1.05)}\",\r\n      \".oa-snapshot-confirm:not(:disabled):active{transform:translateY(1px)}\",\r\n      \".oa-snapshot-confirm:disabled{cursor:not-allowed;background:rgba(148,163,184,.55);color:rgba(255,255,255,.85);box-shadow:none}\",\r\n      \".oa-snapshot-expiry{display:none;margin:-10px 0 0;font-size:11px;line-height:1.4;color:#475569}\",\r\n      \"@media (max-width:640px){#oa-snapshot-overlay{padding:16px}.oa-snapshot-dialog{max-width:100%;padding:24px 20px 20px}.oa-snapshot-text{font-size:13px}}\",\r\n    ].join(\"\");\r\n    document.head.appendChild(style);\r\n  }\r\n\r\n  /**\r\n   * Fire-and-forget prewarm of the dynamic API. The request is proxied by the\r\n   * snapshot gateway to the per-site staging FC function (no keep-warm timer),\r\n   * so the cold start overlaps with the 3s countdown instead of the visitor's\r\n   * first real API call. Result and errors are intentionally ignored.\r\n   */\r\n  function prewarmApi() {\r\n    try {\r\n      fetch(\"/_api/health\", { cache: \"no-store\" }).catch(function () {});\r\n    } catch (e) {\r\n      /* fetch unavailable — prewarm is best-effort only */\r\n    }\r\n  }\r\n\r\n  function applyExpiry(el, expiry) {\r\n    if (!expiry) return;\r\n    var date = new Date(expiry);\r\n    if (isNaN(date.getTime())) return;\r\n    el.textContent = \"本页面将于 \" + date.toLocaleString(\"zh-CN\", {\r\n      year: \"numeric\",\r\n      month: \"numeric\",\r\n      day: \"numeric\",\r\n      hour: \"2-digit\",\r\n      minute: \"2-digit\",\r\n      hour12