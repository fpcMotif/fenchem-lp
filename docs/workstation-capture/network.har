n    overlay.appendChild(dialog);\r\n    document.body.appendChild(overlay);\r\n\r\n    var previousHtmlOverflow = document.documentElement.style.overflow;\r\n    var previousBodyOverflow = document.body.style.overflow;\r\n    document.documentElement.style.overflow = \"hidden\";\r\n    document.body.style.overflow = \"hidden\";\r\n\r\n    // 强制停留：确认按钮在 3s 倒计时结束前禁用，避免访客一闪而过不读提示。\r\n    var timer = setInterval(function () {\r\n      countdown -= 1;\r\n      if (countdown > 0) {\r\n        confirm.textContent = confirmLabel + \"（\" + countdown + \"s）\";\r\n        return;\r\n      }\r\n      clearInterval(timer);\r\n      confirm.disabled = false;\r\n      confirm.textContent = confirmLabel;\r\n      confirm.focus();\r\n    }, 1000);\r\n\r\n    confirm.addEventListener(\"click\", function () {\r\n      if (confirm.disabled) return;\r\n      clearInterval(timer);\r\n      overlay.remove();\r\n      document.documentElement.style.overflow = previousHtmlOverflow;\r\n      document.body.style.overflow = previousBodyOverflow;\r\n    });\r\n  }\r\n\r\n  /**\r\n   * 先看 URL：hideNotice=true（大小写不敏感）供自动化截屏跳过弹窗。\r\n   * 再问网关：模板站 showNotice=false，不弹窗也不展示过期。\r\n   * 拉取失败按普通快照处理（照常弹窗）。\r\n   */\r\n  function start() {\r\n    try {\r\n      var hide = new URLSearchParams(location.search).get(\"hideNotice\");\r\n      if (hide && hide.toLowerCase() === \"true\") return;\r\n    } catch (e) {\r\n      /* URLSearchParams 不可用则照常弹窗 */\r\n    }\r\n\r\n    try {\r\n      fetch(\"/_snapshot/info\", { cache: \"no-store\" })\r\n        .then(function (resp) {\r\n          return resp.ok ? resp.json() : null;\r\n        })\r\n        .then(function (info) {\r\n          if (info && info.showNotice === false) return;\r\n          mount(info);\r\n        })\r\n        .catch(function () {\r\n          mount(null);\r\n        });\r\n    } catch (e) {\r\n      mount(null);\r\n    }\r\n  }\r\n\r\n  if (document.readyState === \"loading\") {\r\n    document.addEventListener(\"DOMContentLoaded\", start