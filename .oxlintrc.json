{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-redundant-roles": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "typescript/no-explicit-any": "warn",
    "typescript/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "tailwindcss",
              "@tailwindcss/*",
              "tailwind-merge",
              "clsx",
              "class-variance-authority",
              "tw-animate-css",
              "styled-components"
            ],
            "message": "Legacy styling libraries are banned. Use StyleX with @fenchem-lp/ui/tokens.stylex."
          }
        ]
      }
    ],
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "Record<string, unknown>": {
            "message": "Use a specific interface or typed object instead of Record<string, unknown>"
          }
        }
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [".agents/**", ".claude/**", "docs/**", "apps/web/public/**"]
}
